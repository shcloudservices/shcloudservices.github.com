# ===============================================
# Soluciones Hospedadas - Environment Variables
# ===============================================

# Port to listen on (Default: 8080)
PORT=8080

# Resend API Key (From https://resend.com/api-keys)
RESEND_API_KEY=re_123456789_abcdefg

# Destination email for form submissions
DESTINATION_EMAIL=contacto@solucioneshospedadas.com

# Sender email configured/verified in Resend
# Note: In development with free tier, use 'Soluciones Hospedadas <onboarding@resend.dev>'
# Once domain is verified in Resend, use 'Soluciones Hospedadas <contacto@solucioneshospedadas.com>'
FROM_EMAIL=Soluciones Hospedadas <onboarding@resend.dev>
